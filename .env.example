# =============================================================================
# SigScale OCS — runtime configuration
# =============================================================================
# Copy this file to `.env` and edit. Variables here drive both docker-compose
# (host bind paths, image, port mappings) and the OCS container itself, which
# renders its `sys.config` at startup from these values. No sys.config file on
# the host is needed unless you set OCS_SYS_CONFIG to override the renderer.
# =============================================================================

# -- Image & container ---------------------------------------------------------
OCS_IMAGE=sigscale-ocs-local:latest
OCS_HOSTNAME=ocs

# -- Host bind paths -----------------------------------------------------------
# Where the container's persistent state lives on the host. Must exist (or be
# creatable by the user running docker compose). Logs (including IPDR) appear
# directly under ${OCS_DATA_DIR}/log/{ipdr,acct,auth,abmf,http,export}.
OCS_DATA_DIR=./data

# -- Bind addresses on the host (left side of port mapping) --------------------
# Set to 0.0.0.0 to expose to the LAN, or 127.0.0.1 to keep internal.
OCS_BIND_HOST=127.0.0.1

# -- Listening ports (host:container) ------------------------------------------
OCS_HTTP_PORT_HOST=8080
OCS_RADIUS_AUTH_PORT_HOST=1812
OCS_RADIUS_ACCT_PORT_HOST=1813
OCS_DIAMETER_ACCT_PORT_HOST=3868
OCS_DIAMETER_AUTH_PORT_HOST=3869

# =============================================================================
# Container-internal settings (consumed by docker-entrypoint.sh)
# =============================================================================

# -- Bootstrap -----------------------------------------------------------------
OCS_INIT_DB=true
OCS_NODENAME=ocs
OCS_DEBUG=false

# Set to a path inside the container if you want to bypass the env-driven
# renderer and ship your own sys.config (mount it as read-only volume too).
# OCS_SYS_CONFIG=/run/config/ocs/sys.config

# -- RADIUS --------------------------------------------------------------------
OCS_RADIUS_AUTH_PORT=1812
OCS_RADIUS_ACCT_PORT=1813

# -- Diameter ------------------------------------------------------------------
OCS_DIAMETER_ACCT_PORT=3868
OCS_DIAMETER_AUTH_PORT=3869
OCS_DIAMETER_ORIGIN_HOST=ocs.localdomain
OCS_DIAMETER_ORIGIN_REALM=localdomain

# -- HTTP / REST ---------------------------------------------------------------
OCS_HTTP_PORT=8080
OCS_HTTP_TLS=false
OCS_HTTP_AUTH_REQUIRE_GROUP=staff
OCS_HTTP_LOG_SIZE_BYTES=10485760
OCS_HTTP_LOG_FILE_COUNT=10

# -- Logs (relative to /home/otp inside the container) -------------------------
OCS_ACCT_LOG_DIR=log/acct
OCS_AUTH_LOG_DIR=log/auth
OCS_ABMF_LOG_DIR=log/abmf
OCS_IPDR_LOG_DIR=log/ipdr
OCS_HTTP_LOG_DIR=log/http
OCS_EXPORT_DIR=log/export

# Accounting log rotation
OCS_ACCT_LOG_ROTATE_MIN=1440
# Erlang time tuple — must include the curly braces.
OCS_ACCT_LOG_ROTATE_TIME={4,4,4}

# Per-log retention. Each log is a FIFO disk_log wrap log: when FILE_COUNT
# files of SIZE_BYTES each are full, the oldest is overwritten. Total disk
# footprint per log is bounded by SIZE_BYTES * FILE_COUNT. Defaults match
# upstream (10 MiB × 100 = ~1 GiB per log). Increase FILE_COUNT to keep
# more events queryable from the REST/UI logs views.
OCS_ACCT_LOG_SIZE_BYTES=10485760
OCS_ACCT_LOG_FILE_COUNT=100
OCS_AUTH_LOG_SIZE_BYTES=10485760
OCS_AUTH_LOG_FILE_COUNT=100
OCS_ABMF_LOG_SIZE_BYTES=10485760
OCS_ABMF_LOG_FILE_COUNT=100

# -- TLS material --------------------------------------------------------------
OCS_TLS_KEY=ssl/key.pem
OCS_TLS_CERT=ssl/cert.pem
OCS_TLS_CACERT=ssl/ca.pem

# -- Mnesia / SNMP -------------------------------------------------------------
OCS_MNESIA_DIR=db
OCS_SNMP_CONF_DIR=snmp/conf
OCS_SNMP_DB_DIR=snmp/db

# -- Session-charging policy ---------------------------------------------------
# Defaults applied when the Diameter peer doesn't send Requested-Service-Unit.
OCS_MIN_RESERVE_OCTETS=10000000
OCS_MIN_RESERVE_SECONDS=60
OCS_MIN_RESERVE_MESSAGES=1

# Recurring-charge scheduler (UTC). The scheduler checks overdue recurring
# products every OCS_CHARGING_INTERVAL minutes starting from the Erlang tuple
# time below.
OCS_CHARGING_SCHEDULER_TIME={4,4,4}
OCS_CHARGING_INTERVAL=1440

# Optional global monthly renewal override (UTC).
# Applies only to monthly recurring entries that do not already have an
# explicit fixed month day configured in the product offering price.
OCS_FORCE_MONTHLY_RENEWAL_ENABLED=false
OCS_FORCE_MONTHLY_RENEWAL_DAY=28
OCS_FORCE_MONTHLY_RENEWAL_TIME={3,0,0}

# `requested` honours the peer's RSU; `fixed` ignores it and uses the
# OCS_EXPLICIT_RESERVE_* values below.
OCS_EXPLICIT_RESERVE_POLICY=requested
OCS_EXPLICIT_RESERVE_OCTETS=undefined
OCS_EXPLICIT_RESERVE_SECONDS=undefined
OCS_EXPLICIT_RESERVE_MESSAGES=undefined

OCS_MAX_RESERVE_OCTETS=10000000
OCS_MAX_RESERVE_SECONDS=undefined
OCS_MAX_RESERVE_MESSAGES=undefined

# Verbose per-session logs — only enable while debugging.
OCS_SESSION_DEBUG_LOGS=false
